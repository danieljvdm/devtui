{
  "name": "devtui",
  "version": "0.1.0",
  "description": "Terminal UI for running local development processes.",
  "keywords": [
    "bun",
    "cli",
    "dev",
    "effect",
    "opentui",
    "tui"
  ],
  "homepage": "https://github.com/danieljvdm/devtui#readme",
  "bugs": {
    "url": "https://github.com/danieljvdm/devtui/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danieljvdm/devtui.git",
    "directory": "packages/devtui"
  },
  "bin": {
    "devtui": "src/index.tsx",
    "devtui-broker": "src/mcp-broker.ts",
    "devtui-mcp": "src/mcp.ts"
  },
  "files": [
    "README.md",
    "src/**/*.ts",
    "src/**/*.tsx",
    "!src/**/*.test.ts"
  ],
  "type": "module",
  "exports": {
    ".": "./src/config.ts",
    "./config": "./src/config.ts",
    "./presets": "./src/presets.ts"
  },
  "scripts": {
    "demo": "bun run src/index.tsx --demo",
    "mcp": "bun run src/mcp.ts",
    "mcp:broker": "bun run src/mcp-broker.ts",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "bun test src/config.test.ts src/core/port-allocator.test.ts src/core/runner.test.ts src/core/text.test.ts src/presets.test.ts src/ui/model.test.ts src/ui/ansi.test.ts src/ui/keyboard.test.ts"
  },
  "dependencies": {
    "@effect/atom-react": "4.0.0-beta.49",
    "@effect/platform-bun": "4.0.0-beta.74",
    "@opentui/core": "^0.1.99",
    "@opentui/react": "^0.1.99",
    "effect": "4.0.0-beta.74",
    "react": "^19.2.6",
    "scheduler": "^0.27.0"
  },
  "devDependencies": {
    "@effect/language-service": "^0.85.1",
    "@effect/tsgo": "0.13.0",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.15",
    "@typescript/native-preview": "7.0.0-dev.20260527.2",
    "typescript": "^6.0.2"
  }
}
