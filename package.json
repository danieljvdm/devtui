{
  "name": "devtui-monorepo",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "postinstall": "bun scripts/postinstall.ts",
    "dev": "bun run packages/devtui/src/index.tsx",
    "demo": "bun run packages/devtui/src/index.tsx --demo",
    "mcp": "bun run packages/devtui/src/mcp.ts",
    "mcp:broker": "bun run packages/devtui/src/mcp-broker.ts",
    "example:one": "bun run packages/devtui/src/index.tsx dev --config packages/devtui/examples/vanilla-one.config.ts",
    "example:multi": "bun run packages/devtui/src/index.tsx dev --config packages/devtui/examples/vanilla-multi.config.ts",
    "example:portless": "bun run packages/devtui/src/index.tsx dev --config packages/devtui/examples/portless-multi.config.ts",
    "check": "vp run -F './packages/*' -F './apps/*' check && tsgo --noEmit -p scripts/tsconfig.json",
    "check:tui": "bun run --cwd packages/devtui check",
    "start": "bun run packages/devtui/src/index.tsx",
    "dev:app": "bun run --cwd apps/app dev",
    "build:app": "bun run --cwd apps/app build"
  },
  "devDependencies": {
    "@effect/language-service": "^0.85.1",
    "@effect/platform-node": "catalog:",
    "@effect/tsgo": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "devtui": "workspace:*",
    "effect": "catalog:",
    "portless": "^0.13.1",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "packageManager": "bun@1.3.9",
  "catalog": {
    "@effect/platform-node": "4.0.0-beta.74",
    "@effect/tsgo": "0.13.0",
    "@types/node": "25.9.1",
    "@typescript/native-preview": "7.0.0-dev.20260527.2",
    "effect": "4.0.0-beta.74",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.1.23",
    "vite-plus": "0.1.23",
    "vitest": "npm:@voidzero-dev/vite-plus-test@0.1.23"
  }
}
