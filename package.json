{
  "name": "vp-effect-cf-template",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "postinstall": "tsx scripts/postinstall.ts",
    "sync:effect": "tsx scripts/sync-effect-submodule.ts",
    "patch:tsgo": "tsx scripts/patch-tsgo.ts",
    "check": "vp run -F './apps/*' -F './packages/*' check && tsgo --noEmit -p scripts/tsconfig.json",
    "check:scripts": "tsgo --noEmit -p scripts/tsconfig.json",
    "build": "vp run -F './apps/*' -F './packages/*' build",
    "ready": "vp run -F './apps/*' -F './packages/*' check && tsgo --noEmit -p scripts/tsconfig.json && vp run -F './apps/*' -F './packages/*' build",
    "dev": "vp run app#dev",
    "dev:app": "vp run app#dev",
    "dev:api": "vp run api#dev"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/tsgo": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "effect": "catalog:",
    "tsx": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.3.9",
  "catalog": {
    "@effect/platform-node": "4.0.0-beta.74",
    "@effect/tsgo": "0.13.0",
    "@types/bun": "1.3.14",
    "@types/node": "25.9.1",
    "@typescript/native-preview": "7.0.0-dev.20260527.2",
    "effect": "4.0.0-beta.74",
    "effect-cf": "0.10.0",
    "tsx": "4.22.3",
    "tsgo": "npm:@typescript/native-preview@7.0.0-dev.20260527.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.1.23",
    "vite-plus": "0.1.23",
    "vitest": "npm:@voidzero-dev/vite-plus-test@0.1.23"
  }
}
